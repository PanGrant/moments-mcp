# 复制为 .env 并填入你的钥匙：cp .env.example .env

# LLM（OpenAI 兼容协议；默认 GLM/智谱，可换任何兼容服务）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.6
LLM_API_KEY=在这里填你的钥匙

# 可选：覆盖组稿模型（默认用 LLM_MODEL）
# DIGEST_SUMMARIZE_MODEL=glm-4.6
# 可选：MCP 家目录（事件/日志，默认 ~/.moments-mcp）
# MOMENTS_MCP_HOME=~/.moments-mcp
# 可选：设置文件路径（默认 仓库根/data/moments_settings.json）
# MOMENTS_SETTINGS=/path/to/moments_settings.json
